{
  "name": "storex",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "test:e2e": "bun run --filter web test:e2e",
    "prepare": "husky",
    "db:generate": "bun --filter @storex/database db:generate",
    "db:push": "bun --filter @storex/database db:push",
    "db:migrate": "bun --filter @storex/database db:migrate",
    "db:seed": "bun --filter @storex/database db:seed",
    "db:studio": "bun --filter @storex/database db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "husky": "^9.1.7",
    "turbo": "^2.10.13",
    "typescript": "^5.7.3"
  }
}
